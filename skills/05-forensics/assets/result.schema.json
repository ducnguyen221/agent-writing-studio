{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "05-forensics evidence bundle",
  "type": "object",
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "rule_id", "group", "tier", "stability", "location",
        "quoted_text", "severity", "evidence", "counterevidence",
        "suggested_fix", "verification_question", "genre_basis"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "minLength": 1 },
        "group": { "enum": ["G1", "G2", "G3", "G4", "G5", "G6"] },
        "tier": { "enum": ["agent", "deterministic", "metadata"] },
        "stability": { "enum": ["stable", "unstable"] },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["section", "paragraph_index", "sentence_id", "quote_anchor"],
          "properties": {
            "section": { "type": "string", "minLength": 1 },
            "paragraph_index": { "type": "integer", "minimum": 0 },
            "sentence_id": { "type": "string", "minLength": 1 },
            "quote_anchor": { "type": "string", "minLength": 1 }
          }
        },
        "quoted_text": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["low", "medium", "high"] },
        "evidence": { "type": "string", "minLength": 1 },
        "counterevidence": { "type": "string", "minLength": 1 },
        "suggested_fix": { "type": "string", "minLength": 1 },
        "verification_question": {
          "type": "string",
          "minLength": 1,
          "description": "Câu hỏi cho tác giả dùng để xác minh nguồn gốc hoặc ý định của đoạn bị nghi vấn."
        },
        "genre_basis": { "type": "string", "minLength": 1 }
      }
    }
  },
  "required": ["schema_version", "run", "document", "verdict", "findings", "sentences"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "run": {
      "type": "object",
      "required": ["created_at", "skill_version", "measurement_mode", "branches"],
      "properties": {
        "created_at": { "type": "string" },
        "skill_version": { "type": "string" },
        "measurement_mode": {
          "enum": ["agent_read", "agent_plus_optional_counts"],
          "description": "Agent đọc trực tiếp là mặc định; script chỉ là lớp kiểm chứng tùy chọn."
        },
        "branches": {
          "type": "object",
          "description": "Ghi rõ nhánh nào đã chạy và có chạy MÙ hay không.",
          "required": ["blind_agent", "deterministic"],
          "properties": {
            "blind_agent": {
              "type": "object",
              "properties": {
                "model": { "type": "string" },
                "sealed_before_counters": { "type": "boolean" }
              }
            },
            "deterministic": { "type": "object" }
          }
        }
      }
    },
    "document": {
      "type": "object",
      "required": ["sha256", "language", "genre"],
      "properties": {
        "sha256": { "type": "string" },
        "language": { "type": "string" },
        "genre": {
          "type": "string",
          "description": "BẮT BUỘC. Mọi ngưỡng đều phụ thuộc thể loại.",
          "examples": ["chinh_luan", "de_cuong_nghien_cuu", "bao_cao_thuc_tap",
                       "sang_kien_kinh_nghiem", "bai_luan_hoc_vien", "blog"]
        },
        "ocr": { "type": "boolean" },
        "extraction_warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["review_priority", "review_priority_range", "ai_signal_coverage", "label", "confidence", "limitations"],
      "properties": {
        "review_priority": {
          "type": "integer", "minimum": 0, "maximum": 100,
          "description": "S — ĐIỂM NGHI VẤN/MỨC ƯU TIÊN XEM LẠI. Không phải xác suất do AI viết."
        },
        "review_priority_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "high", "calibrated"],
          "properties": {
            "low": { "type": "number", "minimum": 0, "maximum": 100 },
            "high": { "type": "number", "minimum": 0, "maximum": 100 },
            "calibrated": { "type": "boolean" }
          }
        },
        "ai_signal_coverage": {
          "type": "object",
          "description": "C — tỷ lệ câu có trọng số mang dấu hiệu AI; không phải tỷ lệ thật do AI sinh.",
          "required": ["percent", "flag_count", "note_count", "eligible_sentence_count"],
          "properties": {
            "percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "low": { "type": "number", "minimum": 0, "maximum": 100 },
            "high": { "type": "number", "minimum": 0, "maximum": 100 },
            "flag_count": { "type": "integer", "minimum": 0 },
            "note_count": { "type": "integer", "minimum": 0 },
            "eligible_sentence_count": {
              "type": "integer",
              "minimum": 0,
              "description": "Có thể bằng 0 khi label là insufficient_evidence."
            },
            "formula": { "const": "100 * (FLAG + 0.4 * NOTE) / eligible_sentences" }
          }
        },
        "label": {
          "enum": ["low_signal", "worth_reviewing", "priority_check",
                   "insufficient_evidence", "verified_fabrication"]
        },
        "confidence": { "enum": ["low", "medium", "high"] },
        "group_scores": {
          "type": "object",
          "additionalProperties": false,
          "description": "Điểm từng nhóm SAU khi áp trần chống đếm trùng.",
          "properties": {
            "G1": { "type": "number", "minimum": 0, "maximum": 30 },
            "G2": { "type": "number", "minimum": 0, "maximum": 20 },
            "G3": { "type": "number", "minimum": 0, "maximum": 25 },
            "G4": { "type": "number", "minimum": 0, "maximum": 25 }
          }
        },
        "branch_comparison": {
          "type": "object",
          "properties": {
            "agreement": { "type": "array", "items": { "type": "string" } },
            "disagreement": { "type": "array", "items": { "type": "string" } },
            "agent_only": { "type": "array", "items": { "type": "string" } },
            "script_only": { "type": "array", "items": { "type": "string" } }
          }
        },
        "limitations": {
          "type": "array", "minItems": 1, "items": { "type": "string" },
          "description": "BẮT BUỘC không rỗng. Luôn phải nói rõ hệ thống không thấy được gì."
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "offset", "review_priority", "alternative_explanation"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "offset": {
            "type": "object",
            "required": ["start", "end"],
            "properties": { "start": { "type": "integer" }, "end": { "type": "integer" } }
          },
          "signals": {
            "type": "object",
            "properties": {
              "deterministic": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["code", "evidence"],
                  "properties": {
                    "code": { "type": "string" },
                    "value": {},
                    "group": { "enum": ["G1", "G2", "G3", "G4", "G5", "G6"] },
                    "evidence": { "type": "string" }
                  }
                }
              },
              "agent": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["code", "evidence", "counterevidence"],
                  "properties": {
                    "code": { "type": "string" },
                    "strength": { "type": "number", "minimum": 0, "maximum": 1 },
                    "evidence": { "type": "string" },
                    "counterevidence": {
                      "type": "string",
                      "description": "BẮT BUỘC. Không nghĩ ra được thì bỏ nhận định."
                    }
                  }
                }
              }
            }
          },
          "review_priority": { "type": "integer", "minimum": 0, "maximum": 100 },
          "reason": { "type": "string" },
          "alternative_explanation": {
            "type": "string",
            "description": "BẮT BUỘC không rỗng."
          },
          "confidence": { "enum": ["low", "medium", "high"] },
          "label": { "enum": ["low_signal", "worth_reviewing", "priority_check",
                              "insufficient_evidence"] }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["raw", "status"],
        "properties": {
          "raw": { "type": "string" },
          "tier": { "enum": ["A", "B", "C", "D"] },
          "status": {
            "enum": ["verified", "not_found", "ambiguous", "service_unavailable",
                     "verified_fabrication"],
            "description": "verified_fabrication CHỈ được đặt sau khi CON NGƯỜI tra tay."
          },
          "checked_by_human": { "type": "boolean" },
          "field_match": {
            "type": "object",
            "properties": {
              "title": { "type": "boolean" }, "author": { "type": "boolean" },
              "year": { "type": "boolean" }, "venue": { "type": "boolean" }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "status": { "const": "verified_fabrication" } },
              "required": ["status"]
            },
            "then": {
              "properties": { "checked_by_human": { "const": true } },
              "required": ["checked_by_human"]
            }
          }
        ]
      }
    },
    "unsourced_numbers": {
      "type": "array",
      "description": "Bảng con số không nguồn -> đưa cho tác giả yêu cầu trưng nguồn.",
      "items": {
        "type": "object",
        "properties": {
          "value": { "type": "string" },
          "sentence_id": { "type": "string" },
          "context": { "type": "string" }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "properties": { "label": { "const": "insufficient_evidence" } },
            "required": ["label"]
          }
        }
      },
      "then": { "properties": { "findings": { "maxItems": 0 } } }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "properties": { "label": { "const": "low_signal" } },
            "required": ["label"]
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "properties": { "review_priority": { "maximum": 29 } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "properties": { "label": { "const": "worth_reviewing" } },
            "required": ["label"]
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "properties": { "review_priority": { "minimum": 30, "maximum": 59 } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "properties": { "label": { "const": "priority_check" } },
            "required": ["label"]
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "properties": { "review_priority": { "minimum": 60 } }
          }
        }
      }
    }
  ]
}
