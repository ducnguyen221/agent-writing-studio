{
  "schema_version": "3.0",
  "group_caps": {
    "G1": 30,
    "G2": 20,
    "G3": 25,
    "G4": 25
  },
  "form_vocabulary_only_multiplier": 0.6,
  "sentence_weights": {
    "PLAIN": 0.0,
    "NOTE": 0.4,
    "FLAG": 1.0
  },
  "cluster_requirement": {
    "applies_to_groups": ["G1", "G2"],
    "distinct_families_in_one_paragraph": 2,
    "same_family_repeats_in_document": 3,
    "solo_signal_max_label": "NOTE",
    "solo_signal_scores": false,
    "rationale": "Một khuôn lẻ là văn người bình thường; cụm nhiều họ tín hiệu cùng một chỗ mới là dáng máy. Tín hiệu đơn lẻ tối đa là NOTE, không bao giờ FLAG, và không cộng điểm vào G1/G2."
  },
  "label_bands": [
    {"minimum": 0, "maximum": 29, "label": "low_signal"},
    {"minimum": 30, "maximum": 59, "label": "worth_reviewing"},
    {"minimum": 60, "maximum": 100, "label": "priority_check"}
  ],
  "uncalibrated_margin": {
    "review_priority": 25,
    "coverage_percent": 10
  },
  "conflict_thresholds": {
    "marked_sentence_ratio": 0.25,
    "document_level_score": 60,
    "document_level_coverage": 10,
    "weak_distributed_score": 30,
    "weak_distributed_coverage": 30
  }
}
